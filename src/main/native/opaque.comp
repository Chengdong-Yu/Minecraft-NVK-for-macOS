#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) buffer Output { uint pixels[]; } outputPixels;
layout(push_constant) uniform Extent { uint width; uint height; uint pitch; } size;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=size.width*size.height)return;
    uint address=(i/size.width)*size.pitch+(i%size.width);
    outputPixels.pixels[address]|=0xff000000u;
}
