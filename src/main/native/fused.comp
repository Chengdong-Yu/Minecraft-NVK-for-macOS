#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0) uniform sampler2D sourceImage;
layout(set=0,binding=1,std430) writeonly buffer Output { uint pixels[]; } dst;
layout(push_constant) uniform Size { uint width,height,pitch,flags; } size;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=size.width*size.height)return;
    uint x=i%size.width,y=i/size.width;
    vec3 rgb=texelFetch(sourceImage,ivec2(x,(size.flags&1u)!=0u?size.height-1u-y:y),0).rgb;
    dst.pixels[y*size.pitch+x]=packUnorm4x8(vec4(rgb.bgr,1.0));
}
