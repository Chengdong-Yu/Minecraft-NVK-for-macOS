+#include "eglcurrent.h"
+#include "eglcontext.h"
+#include "dri_drawable.h"
+#include "gallium/drivers/zink/zink_types.h"
+#include "mc_zink_image.h"
+__attribute__((visibility("default"))) int mc_zink_current_image(MCZinkImage*out)
+{
+   _EGLContext *context=_eglGetCurrentContext();
+   if(!context||!context->DrawSurface||!out)return 0;
+   struct dri2_egl_surface *surface=dri2_egl_surface(context->DrawSurface);
+   struct pipe_resource *pr=surface->dri_drawable?surface->dri_drawable->textures[ST_ATTACHMENT_FRONT_LEFT]:NULL;
+   if(!pr&&surface->front)pr=surface->front->texture;
+   if(!pr||!pr->screen||strncmp(pr->screen->get_name(pr->screen),"zink",4))return 0;
+   struct zink_resource *resource=(struct zink_resource*)pr;
+   struct zink_screen *screen=(struct zink_screen*)pr->screen;
+   if(!resource->obj||!resource->obj->image)return 0;
+   *out=(MCZinkImage){.device=(uintptr_t)screen->dev,.queue=(uintptr_t)screen->queue,.image=(uint64_t)resource->obj->image,
+      .usage=resource->obj->vkusage,.family=screen->gfx_queue,.width=pr->width0,.height=pr->height0,.format=resource->format,.layout=resource->layout};
+   return 1;
+}
+__attribute__((visibility("default"))) int mc_zink_present_current(MCZinkPresent present,void*layer)
+{
+   MCZinkImage info;if(!present||!mc_zink_current_image(&info))return -1;
+   _EGLContext *context=_eglGetCurrentContext();
+   struct dri2_egl_surface *surface=dri2_egl_surface(context->DrawSurface);
+   struct pipe_resource *pr=surface->dri_drawable->textures[ST_ATTACHMENT_FRONT_LEFT];
+   if(!pr&&surface->front)pr=surface->front->texture;
+   struct zink_screen *screen=(struct zink_screen*)pr->screen;
+   simple_mtx_lock(screen->queue_lock);int result=present(&info,layer);simple_mtx_unlock(screen->queue_lock);
+   return result;
+}
